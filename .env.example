# Browser-side Supabase configuration (safe to expose in a Vite build)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Native Google APIs (server-only; never use a VITE_ prefix)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"decorlab-hr", "private_key":"...", "client_email":"..."}
GOOGLE_SHEET_ID=11gz8_k0o12efp-Mh2rhQZGCOl0ZcksgEDpo0QpqLNCs
GOOGLE_DRIVE_ROOT_FOLDER_ID=optional-drive-folder-id
# Required: the cron endpoint expects "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=a-long-random-string

# Role-based access (server-only; profiles are keyed by lowercase email).
ACCESS_ADMIN_EMAILS=admin@example.com
ACCESS_MANAGER_EMAILS=
# Closed by default; set true to let any confirmed account in as an employee.
ACCESS_OPEN_SIGNUPS=false
ACCESS_PROFILES_JSON={"profiles":{}}

# Vercel builds require the VITE_* browser variables at build time.

# Claude scheduled task -> POST /api/public/rdash-ingest with header "x-ingest-key: <this value>" (server-only)
RDASH_INGEST_KEY=a-long-random-string

SUPABASE_URL=https://junxqhokakrxgnlcwmag.supabase.co
VITE_SUPABASE_URL=https://junxqhokakrxgnlcwmag.supabase.co
VITE_SUPABASE_PROJECT_ID=junxqhokakrxgnlcwmag
SUPABASE_SERVICE_ROLE_KEY=<your secret key>